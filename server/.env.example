# ---- Database (required) ----
# Postgres connection string. For the bundled docker-compose stack:
# postgresql://codiee:codiee@localhost:5433/codiee
DATABASE_URL=postgresql://user:password@localhost:5432/codiee

# ---- Auth (required in production) ----
# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- AI providers (optional) ----
# Google Gemini key — enables cloud chat models and RAG embeddings.
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Legacy/alternate Google env var also accepted as a fallback.
GOOGLE_API_KEY=
# Local Ollama endpoint — free alternative, no key needed.
OLLAMA_BASE_URL=http://localhost:11434/v1
# OpenRouter (open models: DeepSeek, Qwen, Llama...) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# NVIDIA NIM (build.nvidia.com hosted models) — key starts with nvapi-
NVIDIA_API_KEY=

# ---- Email / SMTP (signup OTP) ----
# Production (real OTPs to real inboxes) — Gmail example:
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<gmail>  SMTP_PASS=<app password>
# Dev shortcut — Mailpit fake inbox (mails never leave your machine):
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit  → inbox at http://localhost:8025
# With SMTP_HOST unset, OTPs are logged to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Codiee <no-reply@codiee.local>"

# ---- Server (optional) ----
PORT=3005
LOG_LEVEL=info

# ---- Quotas (optional) ----
# Monthly token budget enforced server-side per user.
QUOTA_MONTHLY_TOKENS=500000

# ---- Rate limits (optional, CLI-side pacing) ----
# Max AI requests per minute. Defaults: 8 (chat), 90 (embeddings).
CODIEE_CHAT_RPM_LIMIT=8
CODIEE_EMBED_RPM_LIMIT=90

# ---- CLI (optional) ----
# Where the CLI looks for the auth server (defaults to http://localhost:3005)
CODIEE_SERVER_URL=
